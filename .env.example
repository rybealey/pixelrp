# Database
DB_NAME=pixelrp
DB_USER=pixelrp
DB_PASSWORD=changeme-local
DB_ROOT_PASSWORD=changeme-root

# Emulator
NITRO_PORT=2096
RCON_PORT=30001
# Exact-IP allowlist entries for PlusEMU RCON (CMS static IP)
RCON_ALLOWED_IP=172.28.0.20

# Web
HTTP_PORT=8080
HOTEL_NAME=PixelRP

# Bot
BOT_ENABLED=true
# Leave empty to run everything except the bot (it idles instead of connecting).
ANTHROPIC_API_KEY=
# Dedicated low-privilege MySQL user for the bot (only UPDATE users.auth_ticket).
# Created automatically on first `docker compose up` (fresh db volume); for an
# existing volume see bot/README.md. Leave empty to fall back to DB_USER.
BOT_DB_USER=pixelrp_bot
BOT_DB_PASSWORD=changeme-bot

