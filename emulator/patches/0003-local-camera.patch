+  /**
+   * Reads and validates the Nitro camera payload: int32 length + PNG bytes.
+   * Returns null on any malformed/oversized/non-PNG input.
+   */
+  static byte[] readPngPayload(MessageHandler handler) {
+    try {
+      int length = handler.packet.readInt();
+      int available = handler.packet.getBuffer().readableBytes();
+
+      if (length <= 0 || length > MAX_PNG_BYTES || length > available) {
+        return null;
+      }
+
+      byte[] png = new byte[length];
+      handler.packet.getBuffer().readBytes(png);
+
+      if (png.length < 8 || (png[0] & 0xFF) != 0x89 || png[1] != 'P' || png[2] != 'N' || png[3] != 'G') {
+        return null;
+      }
+      return png;
+    } catch (Exception e) {
+      return null;
+    }
+  }
 
+  static boolean writePng(String directory, String filename, byte[] png) {
+    try {
+      File dir = new File(directory);
+      if (!dir.exists() && !dir.mkdirs()) {
+        LOGGER.error("Camera output directory {} does not exist and could not be created.", directory);
+        return false;
+      }
+      Files.write(new File(dir, filename).toPath(), png);
+      return true;
+    } catch (Exception e) {
+      LOGGER.error("Failed to write camera image {} to {}", filename, directory, e);
+      return false;
     }
+  }
